# =========================================================================
# TALENT PATH SOLUTIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# 1. Google Analytics 4 Measurement ID
# Obtain from GA4 Admin -> Data Streams -> Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 2. Canonical Website URL
VITE_SITE_URL=https://talentpathsolutions.com

# 3. Google SMTP Mail Service Configuration
# Host & Port: Google standard secure SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Google Account Credentials
# Note: Use a 16-character Google App Password (not your personal account password)
# Generated at: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Sender Display & Routing
SMTP_FROM="Talent Path Solutions <your-email@gmail.com>"
SMTP_TO=talentpathsolutions1@gmail.com
# Optional CC & BCC: Leave blank or set only to real, active inboxes to prevent delivery failure bounces
SMTP_CC=
SMTP_BCC=
THANKYOU_CC=
THANKYOU_BCC=

# Email Subject Configuration
SMTP_SUBJECT_PREFIX="Enquiry Leads"
THANKYOU_SUBJECT_PREFIX="Inquiry Confirmation: Talent Path Solutions"
